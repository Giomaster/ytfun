# Set in the MCP host environment. Never put keys in prompts or project records.
YTFUN_STUDIO_DIR=/absolute/private/path/ytfun-data
# Existing owned 0600 file outside Git; used only on explicit disconnect or invalid authorization.
YTFUN_PRIVATE_ENV_FILE=/absolute/private/path/ytfun.env
# Remote inference only. Models and providers are chosen for each operation.
HF_TOKEN=
# Optional paid operations require both this flag and per-operation acknowledgment.
YTFUN_PAID_GENERATION_ENABLED=false
# Optional owner acceptance of generated imperfections without claiming the render was watched.
# Requires structured review.mode=owner_accepted_technical and exact render SHA256; not a provider gate override.
YTFUN_OWNER_ACCEPTED_TECHNICAL_REVIEW_ENABLED=false
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Official metadata discovery; no footage is downloaded.
YOUTUBE_API_KEY=
# OAuth scopes: youtube.upload + youtube.readonly; add yt-analytics.readonly for metrics.
# Use a short-lived OAuth access token, never an API key for uploads.
YOUTUBE_ACCESS_TOKEN=
YOUTUBE_ACCESS_TOKEN_EXPIRES_AT=
# Offline credentials from user-consented Google OAuth; refresh mode takes precedence.
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN_EXPIRES_AT=
YOUTUBE_CHANNEL_ID=
# Required for OAuth in the MCP. Never reuse across grants; setup writes a fresh UUID.
# For a pre-existing grant, stop all MCP processes before assigning its initial UUID.
YTFUN_YOUTUBE_GRANT_ID=
YTFUN_YOUTUBE_PUBLIC_ENABLED=false
YTFUN_YOUTUBE_AUDIT_CONFIRMED=false
# Optional identity label for exported packages (does not authorize API posting).
TIKTOK_ACCOUNT_ID=
# Experimental owned session REST lane; no official OAuth/Direct Post approval implied.
TIKTOK_ACCOUNT_HANDLE=
TIKTOK_SESSION_FILE=/absolute/private/path/outside-git/tiktok-session.json
YTFUN_TIKTOK_SESSION_PUBLISH_ENABLED=false
KWAI_ACCOUNT_ID=
# Official Page Reels only. Set a supported version explicitly after checking Meta docs.
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_GRAPH_API_VERSION=
YTFUN_FACEBOOK_PUBLISH_ENABLED=false
YTFUN_FACEBOOK_APP_REVIEW_CONFIRMED=false
# Optional persistent dispatcher in the MCP process. Deployment/credentials are separate.
YTFUN_DELIVERY_WORKER_ENABLED=false
# Can lower, never raise, the publisher's 250 MiB maximum.
YTFUN_MAX_UPLOAD_BYTES=262144000
# Optional authenticated remote MCP; distinct from social provider OAuth.
# HTTPS ingress forwards to loopback. Never expose an anonymous studio or embed keys in URLs.
YTFUN_MCP_RESOURCE_URL=https://REPLACE_WITH_OWNED_ENDPOINT/mcp
YTFUN_MCP_PORT=8788
# Mandatory on the owner's Mac: both direct and asynchronous local renders are refused.
YTFUN_REMOTE_ASSEMBLY_ONLY=true
# Cognito managed login, public pre-registered client, code + S256 PKCE.
# Include resource=<exact MCP URL> during consent so access-token aud is resource-bound.
YTFUN_MCP_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/REPLACE_WITH_POOL
YTFUN_MCP_AUTHORIZATION_ENDPOINT=https://REPLACE_WITH_DOMAIN.auth.us-east-1.amazoncognito.com/oauth2/authorize
YTFUN_MCP_TOKEN_ENDPOINT=https://REPLACE_WITH_DOMAIN.auth.us-east-1.amazoncognito.com/oauth2/token
YTFUN_MCP_CLIENT_IDS=REPLACE_WITH_PUBLIC_CLIENT_ID
YTFUN_MCP_OWNER_SUBJECTS=REPLACE_WITH_OWNER_SUBJECT
