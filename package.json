{
  "name": "ytfun",
  "version": "0.1.0",
  "description": "Legal-first YouTube trend research and rights-gated compilation studio.",
  "type": "module",
  "bin": {
    "ytfun": "./dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
