    "dev": "tsx src/cli.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "googleapis": "^171.4.0",
    "sharp": "^0.34.5"
  }
}
